{
  "schema_version": 1,
  "adapter": {
    "id": "browser",
    "product": "GoreeCloud Browser",
    "runtime_authority": "GoreeCloud/goreecloud-browser",
    "contract_version": 1
  },
  "capabilities": [
    "content-blocking",
    "tracking-resistance",
    "url-cleaning",
    "privacy-status",
    "user-visible-exceptions"
  ],
  "privacy": {
    "local_first": true,
    "raw_private_activity_exported_for_status": false,
    "remote_tracker_learning": false,
    "remote_tracker_telemetry": false
  },
  "acceptance": {
    "runtime_acceptance_required": true,
    "production_approved": false
  }
}
