{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goreecloud.privacy-shield.signing-key-provider-acceptance.v1",
  "title": "Privacy Shield Signing-Key Provider Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "selection_decision_id",
    "provider_id",
    "provider_implementation",
    "provider_authority",
    "provider_version",
    "exact_source_revision",
    "deployment",
    "producer_identity",
    "algorithms",
    "qualification",
    "privacy",
    "acceptance",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "goreecloud.privacy-shield.signing-key-provider-acceptance.v1"
    },
    "selection_decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "provider_implementation": {
      "type": "string",
      "minLength": 1
    },
    "provider_authority": {
      "type": "string",
      "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "exact_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "deployment_id"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "producer_identity": {
      "type": "string",
      "minLength": 1
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secure_key_generation",
        "non_exportability",
        "caller_authorization",
        "producer_identity_binding",
        "rotation",
        "retirement",
        "emergency_revocation",
        "stale_untrusted_rejection",
        "signing_audit",
        "outage_and_degraded_behavior",
        "recovery_and_continuity",
        "access_control_review",
        "exact_runtime_integration"
      ],
      "properties": {
        "secure_key_generation": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "non_exportability": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "caller_authorization": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "producer_identity_binding": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "rotation": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "retirement": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "emergency_revocation": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "stale_untrusted_rejection": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "signing_audit": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "outage_and_degraded_behavior": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "recovery_and_continuity": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "access_control_review": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "exact_runtime_integration": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_private_payloads_in_acceptance_evidence",
        "secret_material_in_acceptance_evidence",
        "full_capability_tokens_in_acceptance_evidence"
      ],
      "properties": {
        "raw_private_payloads_in_acceptance_evidence": {
          "const": false
        },
        "secret_material_in_acceptance_evidence": {
          "const": false
        },
        "full_capability_tokens_in_acceptance_evidence": {
          "const": false
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "production_approved",
        "exact_revision_required",
        "valid_until"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "revoked"
          ]
        },
        "production_approved": {
          "type": "boolean"
        },
        "exact_revision_required": {
          "const": true
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "result",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "informational"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
