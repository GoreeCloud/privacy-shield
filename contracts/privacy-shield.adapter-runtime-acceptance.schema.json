{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/privacy-shield.adapter-runtime-acceptance.schema.json",
  "title": "GoreeCloud Privacy Shield Adapter Runtime Acceptance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "product",
    "runtime_authority",
    "exact_source_revision",
    "source_tree_sha",
    "runtime_version",
    "package_version",
    "representative_target",
    "capabilities",
    "privacy",
    "acceptance",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "product": {"type": "string", "minLength": 1, "maxLength": 160},
    "runtime_authority": {"type": "string", "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"},
    "exact_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "package_version": {"type": ["string", "null"], "maxLength": 120},
    "representative_target": {"type": "string", "minLength": 1, "maxLength": 200},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_first",
        "raw_private_activity_exported_for_status",
        "remote_tracker_learning",
        "remote_tracker_telemetry"
      ],
      "properties": {
        "local_first": {"const": true},
        "raw_private_activity_exported_for_status": {"const": false},
        "remote_tracker_learning": {"const": false},
        "remote_tracker_telemetry": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_status",
        "production_approved",
        "exact_revision_required",
        "observed_date"
      ],
      "properties": {
        "runtime_status": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "production_approved": {"type": "boolean"},
        "exact_revision_required": {"const": true},
        "observed_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "reference"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "result": {"type": "string", "enum": ["passed", "failed", "informational"]},
          "reference": {"type": "string", "minLength": 1, "maxLength": 1000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 25,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
