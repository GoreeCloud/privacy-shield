{
  "schema_version": 1,
  "contract_id": "goreecloud.privacy-shield.signing-key-provider.v1",
  "purpose": "Fail-closed production signing-key custody requirements for Privacy Shield operation-bound capabilities.",
  "signing_input": {
    "type": "sha256-digest",
    "encoding": "lowercase-hex",
    "raw_capability_payload_visible_to_provider": false
  },
  "required_methods": [
    "activeKey",
    "describeKey",
    "signDigest",
    "verifyDigest",
    "keyProviderCapabilities"
  ],
  "required_production_capabilities": {
    "non_exportable_signing_material": true,
    "opaque_key_references": true,
    "digest_only_signing": true,
    "key_identifiers": true,
    "rotation": true,
    "retirement": true,
    "revocation": true,
    "producer_identity_binding": true,
    "auditable_signing": true,
    "fail_closed_on_untrusted_state": true
  },
  "required_key_metadata": [
    "key_id",
    "provider_id",
    "provider_version",
    "producer_identity",
    "algorithm",
    "status"
  ],
  "verification_trust_states": [
    "active",
    "verifying"
  ],
  "fail_closed_states": [
    "retired",
    "revoked",
    "stale",
    "untrusted",
    "unknown"
  ],
  "source_providers": {
    "InMemoryPrivacySigningKeyProvider": {
      "production_eligible": false,
      "scope": "development-and-tests-only",
      "private_material_residency": "process-memory"
    }
  },
  "release_boundary": {
    "provider_capability_declaration_is_production_acceptance": false,
    "source_validation_is_key_custody_acceptance": false,
    "provider_evaluation_record_required_before_selection": true,
    "provider_evaluation_schema": "contracts/privacy-shield.signing-key-provider-evaluation.schema.json",
    "provider_evaluation_records": "evaluations/signing-key-providers/*.json",
    "provider_evaluation_evidence_content_addressed": true,
    "provider_evaluation_evidence_reference_format": "evidence+sha256:<64-lowercase-hex>:<locator>",
    "provider_evaluation_evidence_package_required": true,
    "provider_evaluation_evidence_package_schema": "contracts/privacy-shield.provider-evidence-package.schema.json",
    "provider_evaluation_evidence_package_records": "evidence/provider-evaluations/*.json",
    "provider_evaluation_evidence_package_is_candidate_evaluation": false,
    "provider_evaluation_evidence_package_is_provider_selection": false,
    "provider_evaluation_evidence_package_is_production_acceptance": false,
    "provider_evaluation_evidence_review_required": true,
    "provider_evaluation_evidence_review_schema": "contracts/privacy-shield.provider-evidence-review.schema.json",
    "provider_evaluation_evidence_review_records": "reviews/provider-evidence/*.json",
    "provider_evaluation_evidence_review_is_candidate_evaluation": false,
    "provider_evaluation_evidence_review_is_provider_selection": false,
    "provider_evaluation_evidence_review_is_production_acceptance": false,
    "provider_evaluation_evidence_review_authority_validated_by_schema": false,
    "provider_evaluation_is_selection": false,
    "provider_evaluation_is_production_acceptance": false,
    "provider_selection_record_required": true,
    "provider_selection_is_production_acceptance": false,
    "provider_selection_schema": "contracts/privacy-shield.signing-key-provider-selection.schema.json",
    "provider_selection_records": "decisions/signing-key-providers/*.json",
    "approved_selection_required_before_acceptance": true,
    "production_acceptance_record_required": true,
    "production_acceptance_schema": "contracts/privacy-shield.signing-key-provider-acceptance.schema.json",
    "production_acceptance_records": "acceptance/signing-key-providers/*.json",
    "exact_provider_runtime_acceptance_required": true,
    "exact_provider_version_binding_required": true,
    "exact_source_revision_binding_required": true,
    "exact_deployment_binding_required": true,
    "acceptance_freshness_required": true,
    "key_generation_and_custody_evidence_required": true,
    "rotation_retirement_revocation_exercises_required": true,
    "producer_identity_binding_evidence_required": true,
    "signing_audit_evidence_required": true,
    "private_material_export_forbidden": true
  }
}
