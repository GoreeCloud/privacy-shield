{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.dev/schemas/privacy-shield/privacy-lock/v1",
  "title": "Privacy Shield Privacy Lock v1",
  "type": "object",
  "required": [
    "lock_id",
    "contract",
    "schema_version",
    "subject_id",
    "actor",
    "mode",
    "reason_code",
    "application_ids",
    "rules",
    "created_at",
    "expires_at",
    "released_at",
    "release"
  ],
  "properties": {
    "lock_id": { "type": "string", "pattern": "^pslock_" },
    "contract": { "const": "goreecloud.privacy-shield.privacy-lock.v1" },
    "schema_version": { "const": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "actor": { "$ref": "#/$defs/actor" },
    "mode": { "enum": ["strict_optional", "custom"] },
    "reason_code": { "type": "string", "minLength": 1 },
    "application_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "released_at": { "type": ["string", "null"], "format": "date-time" },
    "release": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["actor", "reason_code"],
          "properties": {
            "actor": { "$ref": "#/$defs/actor" },
            "reason_code": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["user", "administrator"] }
      },
      "additionalProperties": false
    },
    "optionalCategory": {
      "enum": [
        "optional_data_sharing",
        "optional_personalization",
        "nonessential_background_access",
        "optional_external_processing",
        "optional_ai_context",
        "optional_diagnostics",
        "optional_cross_application_data_use"
      ]
    },
    "rule": {
      "type": "object",
      "required": ["category", "effect", "constraints"],
      "properties": {
        "category": { "$ref": "#/$defs/optionalCategory" },
        "effect": { "enum": ["deny", "constrain"] },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "effect": { "const": "deny" } } },
          "then": { "properties": { "constraints": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "effect": { "const": "constrain" } } },
          "then": { "properties": { "constraints": { "minItems": 1 } } }
        }
      ]
    }
  },
  "additionalProperties": false
}
