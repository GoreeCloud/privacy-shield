{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/privacy-shield.state-provider-selection.schema.json",
  "title": "GoreeCloud Privacy Shield State Provider Selection Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "decision_id",
    "provider_id",
    "provider_name",
    "provider_implementation",
    "integration_authority",
    "evaluation_record_id",
    "scope",
    "evaluation",
    "governance",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract_id": {"type": "string", "const": "goreecloud.privacy-shield.state-provider-selection.v1"},
    "decision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "provider_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider_implementation": {"type": "string", "minLength": 1, "maxLength": 200},
    "integration_authority": {"type": "string", "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$"},
    "evaluation_record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "capability", "authority_state", "environments"],
      "properties": {
        "service": {"type": "string", "const": "privacy-shield"},
        "capability": {"type": "string", "const": "durable-authorization-state"},
        "authority_state": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "consent",
              "policy_versions_and_active_pointer",
              "capability_revocation",
              "single_use_capability_consumption",
              "privacy_evidence_and_chain_head"
            ]
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durability",
        "restart_recovery",
        "atomic_transactions",
        "multi_writer_serializability",
        "distributed_topology",
        "fail_closed_conflict_behavior",
        "backup_restore",
        "migration_rollback",
        "access_control_isolation",
        "privacy_safe_observability",
        "operational_ownership"
      ],
      "properties": {
        "durability": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "restart_recovery": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "atomic_transactions": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "multi_writer_serializability": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "distributed_topology": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "fail_closed_conflict_behavior": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "backup_restore": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "migration_rollback": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "access_control_isolation": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "privacy_safe_observability": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "operational_ownership": {"type": "string", "enum": ["pending", "passed", "failed"]}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "implementation_authorized", "production_acceptance_authorized", "decision_reference", "decided_at", "review_by"],
      "properties": {
        "status": {"type": "string", "enum": ["proposed", "approved", "rejected", "superseded", "revoked"]},
        "implementation_authorized": {"type": "boolean"},
        "production_acceptance_authorized": {"const": false},
        "decision_reference": {"type": "string", "pattern": "^evidence\\+sha256:[0-9a-f]{64}:(?:github://|gdrive://|qualification-run:|artifact:)[A-Za-z0-9._+:/-]+$", "maxLength": 1000},
        "decided_at": {"type": "string", "format": "date-time"},
        "review_by": {"type": "string", "format": "date-time"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentials_in_decision_record", "raw_private_payloads_in_decision_record", "secret_material_in_decision_record"],
      "properties": {
        "credentials_in_decision_record": {"const": false},
        "raw_private_payloads_in_decision_record": {"const": false},
        "secret_material_in_decision_record": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
