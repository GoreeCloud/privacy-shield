{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goreecloud:privacy-shield:browser-runtime-acceptance:v1",
  "title": "Privacy Shield 2.0 GoreeCloud Browser Runtime Acceptance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "browser_repository",
    "privacy_shield_repository",
    "browser_source_revision",
    "browser_source_tree_sha",
    "privacy_shield_source_revision",
    "artifact",
    "target",
    "observed_at",
    "valid_until",
    "dimensions",
    "review",
    "authorization_effect",
    "authority_transfer",
    "production_approved"
  ],
  "properties": {
    "schema_version": {"const": "goreecloud.privacy-shield.browser-runtime-acceptance.v1"},
    "browser_repository": {"const": "GoreeCloud/browser"},
    "privacy_shield_repository": {"const": "GoreeCloud/privacy-shield"},
    "browser_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "browser_source_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "privacy_shield_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sha256", "size_bytes", "runtime_version", "package_version", "build_provenance_reference"],
      "properties": {
        "kind": {"type": "string", "enum": ["android-apk", "linux-binary", "windows-binary", "macos-bundle", "other-compiled-artifact"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "runtime_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "package_version": {"type": ["string", "null"], "maxLength": 120},
        "build_provenance_reference": {"type": "string", "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,700}$", "maxLength": 800}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "os_name", "os_version", "device_class", "engine_family", "engine_version"],
      "properties": {
        "platform": {"type": "string", "enum": ["android", "linux", "windows", "macos", "other"]},
        "os_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "device_class": {"type": "string", "minLength": 1, "maxLength": 160},
        "engine_family": {"type": "string", "enum": ["android-system-webview-chromium", "chromium-cef", "firefox-gecko", "other-mature-engine"]},
        "engine_version": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "observed_at": {"type": "string", "format": "date-time", "maxLength": 40},
    "valid_until": {"type": "string", "format": "date-time", "maxLength": 40},
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_references"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "content-blocking",
              "tracking-resistance",
              "url-cleaning",
              "privacy-status",
              "user-visible-exceptions",
              "private-browsing-isolation",
              "local-substitution",
              "failure-modes",
              "accessibility-status-accuracy",
              "engine-boundary"
            ]
          },
          "status": {"const": "passed"},
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,700}$", "maxLength": 800}
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "disposition", "reviewed_at", "evidence_reference"],
      "properties": {
        "authority": {"type": "string", "minLength": 1, "maxLength": 200},
        "disposition": {"const": "accepted-for-runtime"},
        "reviewed_at": {"type": "string", "format": "date-time", "maxLength": 40},
        "evidence_reference": {"type": "string", "pattern": "^evidence\\+sha256:[0-9a-f]{64}:[^\\s]{1,700}$", "maxLength": 800}
      }
    },
    "authorization_effect": {"const": false},
    "authority_transfer": {"const": false},
    "production_approved": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"artifact": {"properties": {"kind": {"const": "android-apk"}}}}},
      "then": {"properties": {"target": {"properties": {"platform": {"const": "android"}}}}}
    },
    {
      "if": {"properties": {"artifact": {"properties": {"kind": {"const": "linux-binary"}}}}},
      "then": {"properties": {"target": {"properties": {"platform": {"const": "linux"}}}}}
    },
    {
      "if": {"properties": {"artifact": {"properties": {"kind": {"const": "windows-binary"}}}}},
      "then": {"properties": {"target": {"properties": {"platform": {"const": "windows"}}}}}
    },
    {
      "if": {"properties": {"artifact": {"properties": {"kind": {"const": "macos-bundle"}}}}},
      "then": {"properties": {"target": {"properties": {"platform": {"const": "macos"}}}}}
    }
  ]
}
