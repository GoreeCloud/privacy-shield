{
  "schema_version": 2,
  "platform": "privacy-shield",
  "producer_repository": "GoreeCloud/goreecloud-privacy-shield",
  "consumer_repository": "GoreeCloud/goreecloud-mesh",
  "authoritative_contract": "contracts/privacy-shield.platform.json",
  "integration_mode": "read-only-coordination",
  "authority_transfer": false,
  "runtime_acceptance_implied": false,
  "stable_acceptance_implied": false,
  "sensitive_information_allowed": false,
