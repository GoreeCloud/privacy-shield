{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goreecloud.privacy-shield.signing-key-provider-selection.v1",
  "title": "Privacy Shield Signing-Key Provider Selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "decision_id",
    "provider_id",
    "provider_name",
    "integration_authority",
    "scope",
    "evaluation",
    "governance",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "const": "goreecloud.privacy-shield.signing-key-provider-selection.v1" },
    "decision_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "provider_name": { "type": "string", "minLength": 1 },
    "integration_authority": { "type": "string", "pattern": "^GoreeCloud/[A-Za-z0-9._-]+$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "capability", "producer_identity", "environments"],
      "properties": {
        "service": { "const": "privacy-shield" },
        "capability": { "const": "operation-bound-capability-signing" },
        "producer_identity": { "const": "goreecloud-privacy-shield" },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_only_signing",
        "non_exportable_signing_material",
        "opaque_key_references",
        "stable_key_identifiers",
        "rotation_retirement_revocation",
        "producer_identity_binding",
        "privacy_safe_audit",
        "fail_closed_untrusted_state",
        "outage_degraded_behavior",
        "recovery_continuity",
        "access_control_isolation",
        "operational_ownership"
      ],
      "properties": {
        "digest_only_signing": { "enum": ["pending", "passed", "failed"] },
        "non_exportable_signing_material": { "enum": ["pending", "passed", "failed"] },
        "opaque_key_references": { "enum": ["pending", "passed", "failed"] },
        "stable_key_identifiers": { "enum": ["pending", "passed", "failed"] },
        "rotation_retirement_revocation": { "enum": ["pending", "passed", "failed"] },
        "producer_identity_binding": { "enum": ["pending", "passed", "failed"] },
        "privacy_safe_audit": { "enum": ["pending", "passed", "failed"] },
        "fail_closed_untrusted_state": { "enum": ["pending", "passed", "failed"] },
        "outage_degraded_behavior": { "enum": ["pending", "passed", "failed"] },
        "recovery_continuity": { "enum": ["pending", "passed", "failed"] },
        "access_control_isolation": { "enum": ["pending", "passed", "failed"] },
        "operational_ownership": { "enum": ["pending", "passed", "failed"] }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "implementation_authorized",
        "production_acceptance_authorized",
        "decision_reference",
        "decided_at",
        "review_by"
      ],
      "properties": {
        "status": { "enum": ["proposed", "approved", "rejected", "superseded", "revoked"] },
        "implementation_authorized": { "type": "boolean" },
        "production_acceptance_authorized": { "const": false },
        "decision_reference": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "review_by": { "type": "string", "format": "date-time" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_material_in_decision_record",
        "credentials_in_decision_record",
        "raw_private_payloads_in_decision_record",
        "full_capability_tokens_in_decision_record"
      ],
      "properties": {
        "secret_material_in_decision_record": { "const": false },
        "credentials_in_decision_record": { "const": false },
        "raw_private_payloads_in_decision_record": { "const": false },
        "full_capability_tokens_in_decision_record": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
