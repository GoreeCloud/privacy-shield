{
  "schema_version": 1,
  "contract_id": "goreecloud.privacy-shield.state-provider.v1",
  "purpose": "Fail-closed state-provider requirements for production Privacy Shield authority state.",
  "required_methods": [
    "get",
    "set",
    "delete",
    "list",
    "transaction",
    "stateProviderCapabilities"
  ],
  "required_production_capabilities": {
    "durable": true,
    "restart_recovery": true,
    "atomic_transactions": true,
    "multi_writer_serializable": true,
    "distributed": true,
    "fail_closed_on_conflict": true
  },
  "authority_state": [
    "consent",
    "policy_versions_and_active_pointer",
    "capability_revocation",
    "single_use_capability_consumption",
    "privacy_evidence_and_chain_head"
  ],
  "source_providers": {
    "MemoryPrivacyStateStore": {
      "production_eligible": false,
      "scope": "development-and-tests-only"
    },
    "FilePrivacyStateStore": {
      "production_eligible": false,
      "scope": "single-host-durable-development-and-bounded-acceptance",
      "restart_recovery": true,
      "stale_writer_behavior": "fail-closed"
    }
  },
  "release_boundary": {
    "capability_declaration_is_production_acceptance": false,
    "source_validation_is_provider_acceptance": false,
    "exact_provider_runtime_acceptance_required": true,
    "failure_and_recovery_exercises_required": true,
    "operational_backup_and_restore_acceptance_required": true
  }
}
